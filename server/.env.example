# Server bind host and port (0.0.0.0 allows connections from your VPN virtual intranet)
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# Bearer / X-Auth-Token required by the Android app and CLI
# Change this to a strong secret before exposing on your VPN!
BRIDGE_TOKEN=change-me-to-a-strong-secret

# Directory where tasks, progress logs, chat rooms, and outputs are stored
BRIDGE_DATA_DIR=./bridge_data

# Root directory of desktop projects on this PC (new phone rooms will create folders here)
BRIDGE_PROJECTS_ROOT=C:\Users\joseph\Documents

# Optional: Gemini API Key for instant real-time AI replies in project chat rooms
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
